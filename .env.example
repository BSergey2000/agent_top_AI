# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

# Режим MCP сервера: 'True' — stdio (make mcp_stdio), 'False' — streamable-http (make mcp + make inspector)
# Агент (make agent) всегда запускает сервер через stdio, независимо от этого значения
IS_STDIO=True

# OpenRouter: https://openrouter.ai/keys — модель для агента (main.py)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Tavily: https://tavily.com — поиск в интернете для агента (бесплатный тариф, карта не нужна).
# Без ключа агент использует DuckDuckGo, который часто блокирует программные запросы
TAVILY_API_KEY=tvly-your-key-here

# Необязательно: читается в src/utils/secrets.py, но в коде пока не используется
# OPEN_AI_KEY=
